{
  "description": "Prompt brief before every prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/brief.py\"",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
